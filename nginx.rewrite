# Keep the public authorization route distinct from common case-insensitive
# security rules that block repository LICENSE files.
location = /LICENSE {
    return 404;
}

location = /license {
    rewrite ^(.*)$ /index.php?s=$1 last;
}

location / {

    if (!-e $request_filename){

        rewrite  ^(.*)$  /index.php?s=$1  last;   break;

    }

}

