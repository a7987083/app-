[Unit]
Description=ZONOE IPA discovery worker
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/zonoe
Environment=APP_ENV=production
ExecStart=/usr/bin/php /var/www/zonoe/think ipa:worker --sleep=2
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
