[Unit]
Description=ZONOE IPA scheduled range parser batch
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/zonoe
Environment=APP_ENV=production
ExecStart=/usr/bin/php /var/www/zonoe/think ipa:parse-worker --scheduled
TimeoutStartSec=0
